# Server configuration
PYQUEST_HOST=127.0.0.1
PYQUEST_PORT=8080
PYQUEST_DEMO_MODE=false

# Socratic Agentic Hybrid RAG Oracle
# Options: offline (zero-key default) | ollama | gemini | openai_compat
PYQUEST_LLM_PROVIDER=offline
PYQUEST_LLM_MODEL=
PYQUEST_LLM_API_KEY=
PYQUEST_LLM_BASE_URL=
PYQUEST_LLM_TIMEOUT_SECONDS=12.0

# Convenience fallbacks (Docker Compose & CLI compatibility)
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
